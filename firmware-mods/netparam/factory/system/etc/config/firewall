config redirect
	option name			'wan-web1-http-redirect'
	option src			'wan'
	option dest			'lan'
	option dest_port	'80'
	option proto		'tcp'
	option src_dport	'80'
	option enabled		'0'

config redirect
	option name			'wan-web1-https-redirect'
	option src			'wan'
	option dest			'lan'
	option dest_port	'443'
	option proto		'tcp'
	option src_dport	'443'
	option enabled		'0'

config rule
	option name		'wan-web1-http'
	option src 		'wan'
	option family		'ipv4'
	option target		'ACCEPT'
	option enabled	'0'
	option proto		'tcp'
	option dest_port	'80'

config rule
	option name		'wan-web1-https'
	option src 		'wan'
	option family		'ipv4'
	option target		'ACCEPT'
	option enabled	'0'
	option proto		'tcp'
	option dest_port	'443'

